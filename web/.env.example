# Copie este arquivo para .env.local e preencha com os dados do projeto Supabase
# (Painel do Supabase > Project Settings > API Keys / Data API).
#
# Use SOMENTE a chave publishable (sb_publishable_...). Ela é pública por
# natureza e protegida pelas políticas de RLS do banco.
# NUNCA coloque aqui a secret key (sb_secret_...) ou a service_role key:
# tudo que começa com VITE_ é incluído no código enviado ao navegador.
#
# Sem estas variáveis, a aplicação usa os dados demonstrativos locais.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
